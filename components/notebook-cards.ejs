<%
// Template output is parsed as markdown, so emit the grid as one raw HTML
// block. item.image is project-absolute (/images/...); the index lives at the
// site root, so strip the leading slash to keep the site subpath-relocatable.
%>
```{=html}
<div class="notebook-grid">
<% for (const item of items) { %>
<%
const configPath = item["nb-config"];
if (!configPath) throw new Error(`Notebook listing item has no nb-config: ${item.path}`);
const notebook = JSON.parse(Deno.readTextFileSync(configPath));
const image = String(notebook.image ?? "").replace(/^\//, "");
const title = notebook.title?.en ?? "";
if (!image || !title) throw new Error(`Notebook config is missing image or title: ${configPath}`);
%>
<a class="notebook-card" href="<%- item.path %>">
<div class="notebook-card__image-wrap">
<img class="notebook-card__image" src="<%- image %>" alt="<%= title %>" loading="lazy" decoding="async">
</div>
<p class="notebook-card__title"><%= title %></p>
</a>
<% } %>
</div>
```
