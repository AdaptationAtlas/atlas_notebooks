function dataTable(
  data,
  {
    height = "400px",
    zebra = false,
    rows = 25,
    width,
    wrapCells = true,
    horizontalScroll = true,
    ...tableOptions
  } = {}
) {
  const table = Inputs.table(data, {
    height,
    rows,
    width,
    select: false,
    ...tableOptions
  });

  table.classList.add("atlasDataTable");

  const wrapper = html`<div class="atlasDataTableWrap"></div>`;
  wrapper.appendChild(table);

  const style = document.createElement("style");
  style.textContent = `
    .atlasDataTableWrap {
      width: 100%;
      max-width: 100%;
      overflow-x: ${horizontalScroll ? "auto" : "visible"};
      overflow-y: visible;
      -webkit-overflow-scrolling: touch;
      box-sizing: border-box;
    }

    /* Outer host must stay within page width */
    .atlasDataTable {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      box-sizing: border-box;
      overflow: visible !important;
    }

    /* Only inner table may grow for horizontal scroll */
    .atlasDataTable table {
      min-width: 100%;
      width: max-content;
      max-width: none;
      table-layout: auto;
      border-collapse: collapse;
    }

    /* Header */
    .atlasDataTable thead th {
      background-color: #f3f4f6 !important;
      padding: 14px 12px !important;
      line-height: 1.4;
      position: sticky;
      top: 0;
      z-index: 2;
      vertical-align: top;
      box-sizing: border-box;
    }

    /* Cells */
    .atlasDataTable td {
      padding: 12px 15px !important;
      vertical-align: top;
      line-height: 1.35;
      box-sizing: border-box;
    }

    /* Let headers and cells fully show text */
    .atlasDataTable thead th,
    .atlasDataTable tbody td,
    .atlasDataTable thead th *,
    .atlasDataTable tbody td * {
      ${
        wrapCells
          ? `
      white-space: normal !important;
      overflow-wrap: anywhere !important;
      word-break: break-word !important;
      `
          : `
      white-space: nowrap !important;
      `
      }
      overflow: visible !important;
      text-overflow: clip !important;
      max-width: none !important;
    }

    /* Add margin between sort chevron and header text */
    .atlasDataTable thead th > span {
      margin-right: 6px;
    }

    /* Hide leftover checkbox column if present */
    .atlasDataTable th:first-child,
    .atlasDataTable td:first-child {
      display: none;
    }

    /* Hover */
    .atlasDataTable tbody tr:hover {
      background-color: #f1f5f9 !important;
    }

    ${zebra ? `
    .atlasDataTable tbody tr:nth-child(odd) {
      background: #f9fafb !important;
    }` : ""}
  `;

  wrapper.appendChild(style);
  return wrapper;
}

function filterableDataTable(
  data,
  {
    ...tableArgs
  } = {}
) {
  const filter = Inputs.search(data);

  const tableHost = html`<div style="min-width:0;"></div>`;
  const container = html`
    <div style="display:grid; gap:8px; max-width:100%; min-width:0;">
      <div style="max-width:100%; min-width:0;">${filter}</div>
    </div>
  `;
  container.appendChild(tableHost);

  const render = () => {
    tableHost.replaceChildren(dataTable(filter.value, tableArgs));
  };

  filter.addEventListener("input", render);
  render();

  return container;
}