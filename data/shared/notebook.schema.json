{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptationatlas.cgiar.org/data/shared/notebook.schema.json",
  "title": "Atlas notebook configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "image",
    "description",
    "keywords",
    "textDir",
    "contributors",
    "blocks"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "title": { "$ref": "#/$defs/localizedText" },
    "image": { "type": "string", "pattern": "^/images/" },
    "imageAlt": { "$ref": "#/$defs/localizedText" },
    "description": { "type": "string", "minLength": 1 },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "textDir": {
      "type": "string",
      "pattern": "^data/[A-Za-z0-9_-]+/text$"
    },
    "toc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": {
          "type": "string",
          "enum": ["h1", "h1,h2", "h1,h2,h3"]
        }
      }
    },
    "contributors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "developers"],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contributor" }
        },
        "developers": {
          "type": "array",
          "items": { "$ref": "#/$defs/contributor" }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "overview" } },
        { "contains": { "const": "methods" } }
      ],
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "fr"],
      "properties": {
        "en": { "type": "string" },
        "fr": { "type": "string" }
      }
    },
    "contributor": {
      "oneOf": [
        {
          "$ref": "#/$defs/commonContributor"
        },
        {
          "$ref": "#/$defs/customContributor"
        }
      ]
    },
    "commonContributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "common" },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        }
      }
    },
    "customContributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "org"],
      "properties": {
        "type": { "const": "custom" },
        "name": { "type": "string", "minLength": 1 },
        "org": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "url": {
          "type": "string"
        }
      }
    }
  }
}
