import {
  enhancedMultiSelect as enhanceSelect,
} from "/helpers/enhancedMultiSelect.js";

/**
 * Create an Observable multi-select and apply the Atlas behavior.
 *
 * Input-specific settings such as `label`, `value`, and `format` are passed
 * directly to `Inputs.select()`. Atlas enhancement settings are consumed by
 * `enhancedMultiSelect()`.
 *
 * @param {Iterable} options - Options accepted by `Inputs.select()`.
 * @param {object} [config]
 * @param {"change"|"close"} [config.commit="close"] - Recompute dependants
 * after every selection change or once when the menu closes.
 * @returns {HTMLFormElement}
 *
 * @example
 * atlasMultiSelect(["Kenya", "Tanzania", "Uganda"], {
 *   label: "Countries",
 *   value: ["Kenya"],
 *   enableSelectAll: true,
 *   requireAtLeastOne: false,
 * })
 */
function atlasMultiSelect(
  options,
  {
    maxSelections = null,
    requireAtLeastOne = true,
    enableSelectAll = false,
    searchable = false,
    commit = "close",
    compactLabelThreshold = null,
    language = "en",
    labels = {},
    minWidth = "240px",
    maxWidth = "400px",
    ...inputConfig
  } = {},
) {
  const input = Inputs.select(options, {
    ...inputConfig,
    multiple: true,
  });

  enhanceSelect(input, {
    maxSelections,
    requireAtLeastOne,
    enableSelectAll,
    searchable,
    commit,
    compactLabelThreshold,
    language,
    labels,
    minWidth,
    maxWidth,
  });

  return input;
}

/**
 * Enhance an existing `Inputs.select(..., {multiple: true})`.
 *
 * Prefer `atlasMultiSelect()` for normal construction. This wrapper preserves
 * the existing OJS import path while the DOM implementation lives in a native
 * JavaScript module that other shared helpers can import reliably.
 */
function enhancedMultiSelect(viewofSelect, config = {}) {
  return enhanceSelect(viewofSelect, config);
}
