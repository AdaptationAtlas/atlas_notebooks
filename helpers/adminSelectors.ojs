import { lang as Lang } from "/helpers/lang.js";
import {
  enhancedMultiSelect as enhanceSelect,
} from "/helpers/enhancedMultiSelect.js";

/**
 * Atlas administrative selectors.
 *
 * The selection lives here, one cell per level. A notebook renders as many
 * controls as it likes and every one is bound to those same cells, so all of
 * them stay aligned:
 *
 *   import { adminSelect, adminMultiSelect, adminSelections,
 *            admin0Select, admin1Select, admin2Select }
 *     from "/helpers/adminSelectors.ojs";
 *
 *   adminMultiSelect(0, 1, 2)                 // one control per level
 *   adminMultiSelect(0, 1)                    // country + region only
 *   adminSelect(0)                            // single-select country
 *   adminMultiSelect(0, 1, { selectAll: true, searchable: true })
 *
 * The unit of state is the LEVEL, not the trio, which is what makes a partial
 * form safe: `adminMultiSelect(0, 1)` has no way to touch admin 2, so a section
 * whose data stops at admin 1 can render two controls without disturbing the
 * sections that render three.
 *
 * `admin0Select` / `admin1Select` / `admin2Select` are the reactive selections,
 * always arrays — at most one entry in single-select mode, empty when the level
 * is not narrowed.
 *
 * Both modes expose the same thing: an array of real admin units, where empty
 * means the level is not narrowed. Single-select additionally *offers* a
 * "Sub-Saharan Africa" / "Whole country" / "All districts" row, because a single
 * select cannot choose nothing — but picking one stores an empty array, so
 * nothing downstream has to tell the modes apart.
 */

adminTranslations = ({
  country: { en: "Country", fr: "Pays" },
  region: { en: "Region", fr: "Région" },
  district: { en: "District", fr: "District" },
  ssa: { en: "Sub-Saharan Africa", fr: "Afrique subsaharienne" },
  wholeCountry: { en: "Whole country", fr: "Pays entier" },
  allRegions: { en: "All regions", fr: "Toutes les régions" },
  allDistricts: { en: "All districts", fr: "Tous les districts" },
  selectAll: { en: "Select All", fr: "Tout sélectionner" },
  deselectAll: { en: "Deselect All", fr: "Tout désélectionner" },
  noneSelected: { en: "None selected", fr: "Aucune sélection" },
  search: { en: "Search…", fr: "Rechercher…" },
})

// Excluded Atlas-wide. Module level, not per call: two controls on one level must
// offer the same countries or they cannot stay bound to each other.
adminExcludedIso3 = new Set(["SDN"])

countries = {
  const rows = await FileAttachment("/data/shared/atlas_countries.json").json();
  return rows
    .filter((c) => c.include && !adminExcludedIso3.has(c.iso3c))
    .map(({ include, ...rest }) => ({ ...rest, iso3: rest.iso3c }));
}

ssaObj = ({
  admin0_name: null,
  admin1_name: null,
  admin2_name: null,
  iso3: null,
  translation: adminTranslations.ssa,
})

// One query for the whole lookup, indexed once. The pre-consolidation notebooks
// re-queried per interaction and interpolated names into SQL, which broke on
// Côte d'Ivoire's apostrophe.
adminLookup = {
  const db = await DuckDBClient.of({
    admin_lookup: await FileAttachment(
      "/data/shared/gaul24_africa_lookup.parquet",
    ),
  });

  const rows = await db.query(`
    SELECT DISTINCT admin0_name, admin1_name, admin2_name, iso3
    FROM admin_lookup
    ORDER BY iso3, admin1_name, admin2_name
  `);

  const admin1ByIso = new Map();
  const admin2ByRegion = new Map();

  for (const row of rows) {
    if (!row.iso3 || row.admin1_name == null) continue;

    if (!admin1ByIso.has(row.iso3)) admin1ByIso.set(row.iso3, new Map());
    admin1ByIso.get(row.iso3).set(row.admin1_name, {
      admin0_name: row.admin0_name,
      admin1_name: row.admin1_name,
      admin2_name: null,
      iso3: row.iso3,
    });

    if (row.admin2_name == null) continue;
    const key = `${row.iso3}||${row.admin1_name}`;
    if (!admin2ByRegion.has(key)) admin2ByRegion.set(key, []);
    admin2ByRegion.get(key).push({
      admin0_name: row.admin0_name,
      admin1_name: row.admin1_name,
      admin2_name: row.admin2_name,
      iso3: row.iso3,
    });
  }

  return {
    admin1ByIso: new Map(
      Array.from(admin1ByIso, ([iso3, m]) => [iso3, [...m.values()]]),
    ),
    admin2ByRegion,
  };
}

// ── selection state: one holder per level ───────────────────────────────────
// Always arrays, so a single-select control on one level and a multi-select on
// another can share the same state.

viewof admin0Select = Inputs.input([])
viewof admin1Select = Inputs.input([])
viewof admin2Select = Inputs.input([])

// `viewof x` is only referenceable as a literal, so the three are listed rather
// than built in a loop.
adminViews = new Map([
  [0, viewof admin0Select],
  [1, viewof admin1Select],
  [2, viewof admin2Select],
])

// ── cascade: each level's options come from the level above ─────────────────
// Ordinary reactivity, so there is no invalidation code beyond the prune below.

dataAdmin1 = admin0Select.flatMap(
  (c) => adminLookup.admin1ByIso.get(c.iso3) ?? [],
)

dataAdmin2 = admin1Select.flatMap(
  (r) => adminLookup.admin2ByRegion.get(`${r.iso3}||${r.admin1_name}`) ?? [],
)

// True for a row that stands for "do not narrow at this level". Single-select
// offers such rows because it cannot select nothing; they are never stored.
adminIsWholeArea = (level, d) =>
  d == null ||
  (level === 0
    ? d.iso3 == null
    : level === 1
      ? d.admin1_name == null
      : d.admin2_name == null)

adminKeyOf = (level, d) =>
  level === 1
    ? `${d.iso3}||${d.admin1_name ?? ""}`
    : `${d.iso3}||${d.admin1_name ?? ""}||${d.admin2_name ?? ""}`

adminSetView = (view, value) => {
  view.value = value;
  view.dispatchEvent(new Event("input", { bubbles: true }));
}

/**
 * Drop selections below `level` that its new value no longer offers — deselect a
 * country and its regions have to go with it.
 *
 * Called from the control's input handler rather than from a cell of its own: an
 * imported module only computes what something depends on, so a standalone prune
 * cell would never run. Reads the views directly because the reactive cells have
 * not recomputed yet at this point. Prunes every deeper level whether a control
 * for it is on screen or not.
 */
adminPruneBelow = (level) => {
  if (level > 1) return;

  if (level === 0) {
    const a0 = adminViews.get(0).value;
    const a1 = adminViews.get(1).value;
    const valid = new Set(
      a0.flatMap((c) =>
        (adminLookup.admin1ByIso.get(c.iso3) ?? []).map((d) => adminKeyOf(1, d)),
      ),
    );
    const kept = a1.filter((d) => valid.has(adminKeyOf(1, d)));
    if (kept.length !== a1.length) adminSetView(adminViews.get(1), kept);
  }

  const a1 = adminViews.get(1).value;
  const a2 = adminViews.get(2).value;
  const valid = new Set(
    a1.flatMap((r) =>
      (adminLookup.admin2ByRegion.get(`${r.iso3}||${r.admin1_name}`) ?? []).map(
        (d) => adminKeyOf(2, d),
      ),
    ),
  );
  const kept = a2.filter((d) => valid.has(adminKeyOf(2, d)));
  if (kept.length !== a2.length) adminSetView(adminViews.get(2), kept);
}

// The whole selection in one piece, for helpers/adminBoundaries.js.
adminSelections = ({
  admin0: admin0Select,
  admin1: admin1Select,
  admin2: admin2Select,
})

// ── controls ────────────────────────────────────────────────────────────────

// Single-select needs an explicit "do not narrow here" row; multi-select says the
// same thing by selecting nothing, and adding the row there made a country with
// no region chosen count as a selection ("43 selected" for 43 countries).
adminOptionsFor = (level, multiple, _lang) => {
  if (level === 0) {
    return multiple ? countries : [ssaObj, ...countries];
  }

  if (level === 1) {
    if (multiple) return dataAdmin1;
    return admin0Select.flatMap((c) => [
      { admin0_name: c.admin0_name, admin1_name: null, admin2_name: null, iso3: c.iso3 },
      ...(adminLookup.admin1ByIso.get(c.iso3) ?? []),
    ]);
  }

  if (multiple) return dataAdmin2;
  return admin1Select.flatMap((r) => [
    { ...r, admin2_name: null },
    ...(adminLookup.admin2ByRegion.get(`${r.iso3}||${r.admin1_name}`) ?? []),
  ]);
}

adminOptionLabel = (level, d, _lang) => {
  if (level === 0) {
    return d.translation ? _lang(d.translation) : d.admin0_name ?? d.iso3;
  }
  if (level === 1) {
    return d.admin1_name == null
      ? `${_lang(adminTranslations.wholeCountry)} (${d.iso3})`
      : `${d.admin1_name} (${d.iso3})`;
  }
  return d.admin2_name == null
    ? `${_lang(adminTranslations.allDistricts)} (${d.iso3})`
    : `${d.admin2_name} (${d.iso3})`;
}

adminLevelLabel = (level, _lang) =>
  _lang([adminTranslations.country, adminTranslations.region, adminTranslations.district][level])

// One control for one level, two-way bound to that level's state cell.
//
// Not `Inputs.bind` for single-select: the state is an array and a single select
// speaks in one row, so the two convert at the boundary. Multi-select matches the
// state shape and binds directly.
adminControl = (level, config) => {
  const {
    multiple = false,
    langKey = "en",
    maxSelections,
    requireAtLeastOne = false,
    selectAll = false,
    searchable = false,
  } = config;

  const _lang = Lang.lg(langKey);
  const name = `admin${level}`;
  const perLevel = (opt, fallback) =>
    opt && typeof opt === "object" && !Array.isArray(opt)
      ? (opt[name] ?? fallback)
      : (opt ?? fallback);

  const options = adminOptionsFor(level, multiple, _lang);
  const view = adminViews.get(level);
  const input = Inputs.select(options, {
    label: adminLevelLabel(level, _lang),
    format: (d) => adminOptionLabel(level, d, _lang),
    multiple,
    value: multiple ? view.value : view.value[0],
  });

  (input.querySelector("select") ?? input).disabled = options.length === 0;

  if (multiple) {
    enhanceSelect(input, {
      maxSelections: perLevel(maxSelections, Infinity),
      requireAtLeastOne: perLevel(requireAtLeastOne, false),
      enableSelectAll: options.length > 0 && perLevel(selectAll, false),
      searchable: options.length > 0 && perLevel(searchable, false),
      // No `commit` override: enhancedMultiSelect defaults to "close", so the
      // selection commits once when the dropdown closes. The bundled selector
      // forced "change", which fired a query per checkbox click.
      compactLabelThreshold: 5,
      labels: {
        selectAll: _lang(adminTranslations.selectAll),
        deselectAll: _lang(adminTranslations.deselectAll),
        noneSelected: _lang(
          level === 0
            ? adminTranslations.noneSelected
            : level === 1
              ? adminTranslations.allRegions
              : adminTranslations.allDistricts,
        ),
        search: _lang(adminTranslations.search),
      },
    });
    // Multi-select already speaks in arrays, so it binds to the state directly.
    Inputs.bind(input, view);
  } else {
    input.addEventListener("input", (event) => {
      event.stopPropagation();
      // A null-name row ("Sub-Saharan Africa", "Whole country", "All districts")
      // means this level is not narrowed, which is exactly what an empty
      // selection means in multi-select — so it is stored as one. The row exists
      // only because a single select has no way to choose nothing, and keeping it
      // in the state would give the two modes different shapes for one meaning.
      adminSetView(view, adminIsWholeArea(level, input.value) ? [] : [input.value]);
    });
  }

  // Registered after the binding above, so this sees the level's new value.
  input.addEventListener("input", () => adminPruneBelow(level));

  return input;
}

// Levels as varargs with an optional trailing config, so a call reads as the
// levels it shows: adminMultiSelect(0, 1), adminSelect(0, { langKey: "fr" }).
adminForm = (args, multiple) => {
  const rest = [...args];
  const config =
    rest.length && typeof rest[rest.length - 1] === "object" ? rest.pop() : {};
  const levels = (rest.length ? rest : [0, 1, 2])
    .filter((level) => [0, 1, 2].includes(level))
    .sort((a, b) => a - b);

  if (!levels.length) {
    throw new TypeError("adminSelect() needs at least one of levels 0, 1, 2");
  }

  return Inputs.form(
    levels.map((level) => adminControl(level, { ...config, multiple })),
    {
      template: (inputs) =>
        html`<div class="atlas-admin-selectors" style="display: flex; flex-wrap: wrap; gap: 2em;">${inputs}</div>`,
    },
  );
}

adminSelect = (...args) => adminForm(args, false)

adminMultiSelect = (...args) => adminForm(args, true)
