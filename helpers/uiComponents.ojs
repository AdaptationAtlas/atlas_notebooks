//WARNING: For this file to work correctly, it must have the OJS extension, this is because of the OJS Inputs, TOC generator and similar.
//Alternative would be to require the libraries in the module.

import { atlasHero as canonicalAtlasHero } from "/helpers/hero.js";

/**
 * Compatibility wrapper for the canonical circular Atlas hero.
 *
 * Accepts both `atlasHero({title, image, group, alt})` and the previous
 * positional `atlasHero(title, image)` signature.
 */
function atlasHero(options, image, group = "", alt = "") {
  return options !== null && typeof options === "object"
    ? canonicalAtlasHero(options)
    : canonicalAtlasHero({ title: options, image, group, alt });
}


CSV_BOM = "\uFEFF";

function csvColumns(data, columns) {
  if (columns !== undefined && !Array.isArray(columns)) {
    throw new TypeError("CSV columns must be an array");
  }

  return columns ?? Object.keys(data[0] ?? {});
}

function escapeCsvField(value) {
  if (value == null) return "";

  const text = String(value).replace(/\r\n?|\n/g, "\r\n");
  return /[",\r\n]/.test(text) ? `"${text.replaceAll('"', '""')}"` : text;
}

/**
 * Serialize object rows as an RFC 4180-compatible UTF-8 CSV.
 *
 * The UTF-8 BOM helps spreadsheet applications preserve accented
 * administrative names. Records use CRLF and fields containing commas,
 * quotes, CR, or LF are quoted with doubled internal quotes.
 *
 * @param {Array<object>} data
 * @param {object} [options]
 * @param {string[]} [options.columns] Ordered keys to include.
 * @returns {string}
 */
function serializeCsv(data, { columns } = {}) {
  const rows = Array.isArray(data) ? data : [];
  const selectedColumns = csvColumns(rows, columns);
  if (!selectedColumns.length) return CSV_BOM;

  const records = [
    selectedColumns.map(escapeCsvField).join(","),
    ...rows.map((row) =>
      selectedColumns.map((column) => escapeCsvField(row?.[column])).join(","),
    ),
  ];

  return `${CSV_BOM}${records.join("\r\n")}\r\n`;
}

function csvFilename(filename) {
  const name = String(filename || "atlas-data").trim() || "atlas-data";
  return name.toLowerCase().endsWith(".csv") ? name : `${name}.csv`;
}

function downloadCsv(data, { filename = "atlas-data", columns } = {}) {
  const blob = new Blob([serializeCsv(data, { columns })], {
    type: "text/csv;charset=utf-8",
  });
  const url = window.URL.createObjectURL(blob);
  const link = document.createElement("a");

  link.href = url;
  link.download = csvFilename(filename);
  link.hidden = true;
  document.body.appendChild(link);
  link.click();
  link.remove();

  window.setTimeout(() => window.URL.revokeObjectURL(url), 0);
}

/**
 * Create a button that downloads object rows as a CSV file.
 *
 * @param {Array<object>} data
 * @param {object} [options]
 * @param {string} [options.filename="atlas-data"]
 * @param {string} [options.label="Download CSV"]
 * @param {string[]} [options.columns] Ordered keys to include.
 * @returns {Button}
 */
function downloadCsvButton(
  data,
  {
    filename = "atlas-data",
    label = "Download CSV",
    columns,
  } = {},
) {
  return Inputs.button(label, {
    reduce: () => downloadCsv(data, { filename, columns }),
  });
}

/**
 * @deprecated Use `serializeCsv(data, {columns})`.
 */
function convertToCSV(data, options = {}) {
  return serializeCsv(data, options);
}

/**
 * @deprecated Use `downloadCsv(data, {filename, columns})`.
 */
function downloadData(data, filename) {
  return downloadCsv(data, { filename });
}

/**
 * @deprecated Use `downloadCsvButton(data, {filename, label, columns})`.
 */
function downloadButton(data, filename, label = "Download") {
  return downloadCsvButton(data, { filename, label });
}

/**
 * Creates an interactive collapsible section (using `<details>` and `<summary>`)
 * with a custom title and content blocks. This is designed for use in
 * Observable or other template-literal HTML environments.
 *
 * @param {string}  title - The title of the collapsible section
 * @param {boolean} initiallyOpen - If true, the section is expanded on load.
 * @param {...any} contents - One or more HTML or string elements to display
 *                            inside the dropdown body.
 *
 * @returns {object} An object containing the HTML content for the dropdown.
 */
dropdown_section = (title, initiallyOpen, ...contents) => {
  return html`
    <details ${initiallyOpen ? "open" : ""} style="border-radius:5px; background:none; max-width:900px; padding:0;">
      <summary style="cursor:pointer; font-weight:bold; font-size:1.5rem;">
        ${title}
      </summary>
      ${contents.map(c => html`
        <div style="margin:0.5em 0; border-top:1px dashed #888; padding-top:0.5em;">
          ${c}
        </div>
      `)}
    </details>
  `;
};

/**
 * Creates a label with a CSS-based hover tooltip.
 *
 * @param {Object} options - Configuration options for the tooltip label
 * @param {string} [options.labelText="Dropdown label"] - The visible text of the label
 * @param {string} [options.tooltipText="Tooltip text"] - The text shown in the tooltip on hover
 *
 * @returns {HTMLElement} An Atlas-styled tooltip label
 *
 */
function makeTooltipLabel({
  labelText = "Dropdown label",
  tooltipText = "Tooltip text",
} = {}) {
  return htl.html`
    <span
      class="atlas-tooltip-label"
      data-atlas-tooltip="${tooltipText}"
      aria-label="${`${labelText}: ${tooltipText}`}"
      tabindex="0"
    >${labelText}</span>
  `;
}
