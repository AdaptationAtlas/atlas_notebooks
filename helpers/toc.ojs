/** Compatibility wrapper for the canonical `<atlas-toc>` component. */
function atlasTOC({
  selector = "h1",
  heading = "In this notebook",
  skip = ["notebook-title"],
  activeClass = "active",
} = {}) {
  const toc = document.createElement("atlas-toc");
  const headingContainer = document.createElement("span");

  // Strip legacy heading markup before passing it to the component.
  headingContainer.innerHTML = String(heading);

  toc.setAttribute("heading", headingContainer.textContent || "Contents");
  toc.setAttribute("selector", selector);
  toc.setAttribute(
    "ids-to-ignore",
    (Array.isArray(skip) ? skip : [skip]).filter(Boolean).join(","),
  );
  toc.setAttribute("active-class", activeClass);

  return toc;
}
