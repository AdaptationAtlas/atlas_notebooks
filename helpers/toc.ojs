/**
 * Compatibility wrapper for the canonical `<atlas-toc>` web component.
 *
 * New pages may use `<atlas-toc>` directly. Existing OJS consumers can keep
 * calling `atlasTOC()` with the same options.
 */
function atlasTOC({
  selector = "h1",
  heading = "In this notebook",
  skip = ["notebook-title"],
  activeClass = "active",
} = {}) {
  const toc = document.createElement("atlas-toc");
  const headingContainer = document.createElement("span");

  // Legacy callers sometimes pass simple markup such as "<b>Contents</b>".
  // The component owns the visual weight, so retain the text without injecting
  // caller-provided HTML into the document.
  headingContainer.innerHTML = String(heading);

  toc.setAttribute("heading", headingContainer.textContent || "Contents");
  toc.setAttribute("selector", selector);
  toc.setAttribute(
    "ids-to-ignore",
    (Array.isArray(skip) ? skip : [skip]).filter(Boolean).join(","),
  );
  toc.setAttribute("active-class", activeClass);

  return toc;
}
